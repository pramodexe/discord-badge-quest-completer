{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Badge and Quest Completer",
  "version": "1.2.1",
  "identifier": "me.markterence.discordquestcompleter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Discord Badge and Quest Completer",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://cdn.discordapp.com",
        "style-src": "'unsafe-inline' 'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Show Discord a game as running, for Quests and badges.",
    "category": "Utility",
    "publisher": "pramodexe",
    "homepage": "https://github.com/pramodexe/discord-badge-quest-completer",
    "longDescription": "Makes Discord show you as playing a game without installing it, to finish Discord Quests and climb the Game Variety and Game Time badges. Works with the Discord desktop app on Windows and Linux."
  }
}
